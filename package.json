{
  "name": "realestate-backend",
  "version": "2.0.0",
  "private": true,
  "description": "Real Estate API - TypeScript, PostgreSQL, OpenAPI, RESO-aligned",
  "type": "module",
  "scripts": {
    "dev": "docker compose --env-file .env --env-file IMAGE_VERSION up --build",
    "dev:listings": "cd services/listings && bun run dev",
    "dev:users": "cd services/users && bun run dev",
    "dev:tenants": "cd services/tenants && bun run dev",
    "dev:platform": "cd services/platform && npx tsx watch src/index.ts",
    "build": "npm run build --workspaces --if-present",
    "docker:build": "sh scripts/build-images.sh",
    "ecr:push": "sh scripts/push-ecr-images.sh",
    "ecr:push:platform": "SERVICES=platform sh scripts/push-ecr-images.sh",
    "ecr:secret": "sh scripts/create-ecr-secret.sh",
    "k8s:app-secret": "sh scripts/create-app-secrets.sh",
    "k8s:sync-versions": "sh scripts/sync-k8s-values.sh",
    "k8s:diagnose:app": "sh scripts/diagnose-k8s-app.sh",
    "k8s:diagnose:postgres": "sh scripts/diagnose-k8s-postgres.sh",
    "k8s:deploy": "sh scripts/deploy-k8s.sh all",
    "k8s:deploy:development": "sh scripts/deploy-k8s-development.sh",
    "k8s:deploy:staging": "sh scripts/deploy-k8s-staging.sh",
    "test": "npm run test --workspaces --if-present",
    "db:up": "docker compose --env-file .env --env-file IMAGE_VERSION up -d postgres",
    "db:generate": "npm run db:generate --workspaces --if-present",
    "db:migrate": "npm run db:migrate --workspaces --if-present"
  },
  "workspaces": [
    "services/*",
    "packages/shared"
  ],
  "engines": {
    "node": ">=20"
  },
  "author": "Emmanuel Adedeji",
  "license": "ISC",
  "devDependencies": {
    "drizzle-orm": "^0.45.2"
  }
}
